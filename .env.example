# ──────────────────────────────────────────────────────────────
# Halo — environment variables
#
# The app runs in a clean, fully functional DEMO MODE when the
# Supabase variables below are absent. Fill them in to enable
# real authentication and persistence.
# ──────────────────────────────────────────────────────────────

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Google OAuth must also be enabled in the Supabase dashboard
# (Authentication → Providers → Google) for the "Continue with Google"
# button to appear on the sign-in page.

# Stripe (optional — billing falls back to a clean simulated flow without it)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public site URL, used for auth redirects and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
