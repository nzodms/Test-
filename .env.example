# ──────────────────────────────────────────────────────────────
# Argus — environment variables
#
# All of these are OPTIONAL. With none of them set, the app runs in
# a clean demo mode: every route works and the scan plays against a
# deterministic simulated dataset.
# ──────────────────────────────────────────────────────────────

# Supabase (https://supabase.com/dashboard → Project Settings → API)
# Setting these switches auth and persistence from demo to real, and
# gates /dashboard behind a session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Google OAuth must also be enabled in the Supabase
# dashboard (Authentication → Providers → Google) for the
# "Continue with Google" button to appear on /sign-in.

# Public site URL — used for metadata, Open Graph and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
